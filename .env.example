# ============================================================
# MontrixTech — environment variables
# Copy to `.env.local` for local dev, or set in your deployment
# environment (AWS, Vercel, etc.) for production.
# ============================================================

# -------- Contact form (email delivery) --------
# Provider: "console" | "resend" | "sendgrid"
# "console" logs the payload to the server console (default, good for dev).
EMAIL_PROVIDER=console

# Destination address — where enquiry emails are delivered.
CONTACT_TO_EMAIL=contact@montrixtech.in

# Destination address for job applications.
CAREERS_TO_EMAIL=careers@montrixtech.in

# Envelope From: address — must be verified with the chosen provider.
CONTACT_FROM_EMAIL=no-reply@montrixtech.in

# -------- Provider credentials --------
# Resend (https://resend.com/api-keys)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid (https://app.sendgrid.com/settings/api_keys)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# AWS SES — uses the standard AWS SDK env vars:
# EMAIL_PROVIDER=ses
# SES_AWS_REGION=ap-south-1
# SES_AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
# SES_AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------- Site URL (used for sitemap + canonical URLs) --------
NEXT_PUBLIC_SITE_URL=https://montrixtech.in
